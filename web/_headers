

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://*.music.126.net; media-src 'self' https://*.music.126.net; connect-src 'self' https://*.music.126.net; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Assets keep stable file names, so browsers must revalidate them (cheap 304 via ETag).
# Otherwise the default 4-hour cache can mix an old module with a new one after a deploy.
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=86400
# The service worker must always be checked for updates; it versions the offline copy of the app.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=0, must-revalidate
/icons/*
  Cache-Control: public, max-age=86400
